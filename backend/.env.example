# ============================================================================
# Botanique backend - copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

PORT=4000
NODE_ENV=development
# Local frontend origins allowed by CORS (comma separated)
CORS_ORIGIN="http://localhost:8100,http://localhost:4200"
UPLOAD_DIR="uploads"

# PostgreSQL connection string (Render, Neon, local Postgres, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Number of reverse proxies in front of the API (Render = 1, local = 0).
TRUST_PROXY=0

# Optional: e-mail of the FIRST administrator row to create when seeding.
# Register this e-mail in the app, verify it, and the row links to your login.
# SEED_ADMIN_EMAIL="you@example.com"

# ----------------------------------------------------------------------------
# Firebase Admin SDK  (verifies Firebase ID tokens)
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Copy the three values from the downloaded JSON. Never commit
# that JSON file. Keep the private key on ONE line with literal \n sequences.
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ----------------------------------------------------------------------------
# Maya Checkout (SANDBOX). Keys: Maya Business Manager -> Developer Sandbox
# Application Management. Backend only - never put these in the Angular app.
# ----------------------------------------------------------------------------
MAYA_ENV="sandbox"
MAYA_PUBLIC_KEY=""
MAYA_SECRET_KEY=""
# Optional override (defaults to https://pg-sandbox.paymaya.com for sandbox)
# MAYA_BASE_URL=""
# Any long random string (e.g. `openssl rand -hex 32`). It becomes part of the
# webhook URL registered with Maya.
MAYA_WEBHOOK_SECRET=""
# true = additionally accept webhooks only from Maya's published IPs
MAYA_WEBHOOK_ENFORCE_IP="false"
# Public https URL of THIS backend (no trailing slash). Maya cannot reach
# localhost - use your deployed URL or a tunnel (ngrok / cloudflared).
BACKEND_PUBLIC_URL=""
# Where Maya sends the customer back to (Angular app origin, no trailing slash)
FRONTEND_URL="http://localhost:8100"

# ----------------------------------------------------------------------------
# EmailJS (server-side REST API). Dashboard -> Account.
# Also enable: Account -> Security -> "Allow EmailJS API for non-browser
# applications". The private key must never reach a browser.
# ----------------------------------------------------------------------------
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAILJS_SERVICE_ID=""
EMAILJS_ORDER_TEMPLATE_ID=""
# Optional: generic template for in-app notification e-mails
# (variables: customer_email, customer_name, notification_title, notification_message)
EMAILJS_NOTIFICATION_TEMPLATE_ID=""
# Optional: shown in the e-mail footer
EMAILJS_SUPPORT_EMAIL=""
