# ============================================================================
# FRONTEND (Angular / Ionic)
# Angular does NOT read .env files. The Firebase WEB config lives in
#   src/environments/environment.ts       (ng serve)
#   src/environments/environment.prod.ts  (ng build)
# Copy these values from Firebase console -> Project settings -> Your apps
# -> Web app -> SDK setup and configuration. They are public identifiers (not
# secrets). Do NOT put a service-account key, Maya key or EmailJS private key
# anywhere in the frontend.
#
# This file is documentation only. Backend variables are in backend/.env.example
# ============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# environment.apiUrl -> http://localhost:4000/api  (dev)  /  your deployed API (prod)
